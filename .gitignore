# Entornos y archivos compilados de Python
.venv/
/venv/
__pycache__/
*.py[cod]

# Cachés y resultados locales de análisis/pruebas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
/notas

# Comparadores, capturas, prototipos y diagnósticos locales
.local/
*.log

# Configuración local; las plantillas sí se pueden versionar
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Escrituras temporales del generador y copias del editor
*.html.tmp
*.swp
*.swo
*~

# Metadatos de macOS
.DS_Store
._*

# Se versionan HTML de publicación, fuentes, pruebas, uv.lock,
# documentación y .vscode/settings.json (puerto compartido de Live Server).
