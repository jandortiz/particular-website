# Entornos y archivos compilados de Python
.venv/
/venv/
__pycache__/
*.py[cod]

# Cachés y resultados locales de análisis/pruebas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
/notas

# Guías y bitácora del trabajo con asistentes: viven en este equipo, como /notas.
# Si se versionaran, GitHub Pages las publicaría en jandortiz.com.
/AGENTS.md
/CLAUDE.md
/BITACORA.md

# Comparadores, capturas, prototipos y diagnósticos locales
.local/
*.log

# Configuración local; las plantillas sí se pueden versionar
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Escrituras temporales del generador y copias del editor
*.html.tmp
*.swp
*.swo
*~

# Metadatos de macOS
.DS_Store
._*

# Se versionan HTML de publicación, _portfolio/ (contenido, plantillas, generador y
# pruebas: sin él no se pueden regenerar las páginas), fuentes, imágenes, uv.lock,
# README, LICENSE y .vscode/settings.json (puerto compartido de Live Server).
